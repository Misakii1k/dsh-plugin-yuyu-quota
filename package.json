{
  "name": "dsh-plugin-yuyu-quota",
  "version": "1.0.4",
  "description": "DeepSeek Harness 插件：实时查询并监控鱼鱼API (sub.anzhiyu.com) 账户真实余额、今日用量与API密钥状态",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "yuyu-config.json",
    "一键配置.bat",
    "setup.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test:query": "node test-fetch.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "yuyu-api",
    "quota",
    "balance",
    "token-tracker"
  ],
  "author": "User",
  "license": "MIT",
  "dependencies": {
    "cordis": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
