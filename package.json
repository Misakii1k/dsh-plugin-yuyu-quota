{
  "name": "dsh-plugin-yuyu-quota",
  "version": "1.1.1",
  "description": "DeepSeek-Harness 插件：实时监控鱼鱼API (sub.anzhiyu.com) 多账号余额与额度，并在每轮对话结束后用 Windows 原生通知汇报本轮 Token 与实扣额度（零MCP依赖，可拖动浮窗，支持 GitHub + Cloudflare 云端版本推送）",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "tutorial.html",
    "一键配置.bat",
    "setup.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node scripts/smoke-test.mjs && node scripts/cf-functions-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:cf": "node scripts/cf-functions-test.mjs",
    "pack": "node scripts/pack.mjs",
    "gen-version": "node scripts/gen-version.mjs",
    "test:query": "node test-fetch.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "yuyu-api",
    "quota",
    "balance",
    "token-tracker",
    "notification",
    "auto-update"
  ],
  "author": "User",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
